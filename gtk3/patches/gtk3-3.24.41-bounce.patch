From: GTK Bounce Builder
Subject: [PATCH] gtk3: bounce scrolled content within a native clipping window

Port Christian Hergert's GTK 4 overscroll spring constants and resistance
curve to GTK 3.24. Native GdkWindows keep the visual content and input
coordinates together; scrollbars remain fixed outside the clipping window.
Redraw the complete content region, including the final zero-overshoot frame.

Based on:
https://gist.github.com/chergert/91b4feb1e359c916bcf86ae2ea1f5044

Target: GTK 3.24.41, Ubuntu source 3.24.41-4ubuntu1.3.
---
--- a/gtk/gtkscrolledwindow.c
+++ b/gtk/gtkscrolledwindow.c
@@ -175,9 +175,11 @@
 #define TOUCH_BYPASS_CAPTURED_THRESHOLD 30
 
 /* Kinetic scrolling */
-#define MAX_OVERSHOOT_DISTANCE 100
+#define MAX_OVERSHOOT_DISTANCE 600
+#define OVERSHOOT_VISUAL_DISTANCE 240
+#define OVERSHOOT_VISUAL_RESISTANCE 390
 #define DECELERATION_FRICTION 4
-#define OVERSHOOT_FRICTION 20
+#define OVERSHOOT_FRICTION 31
 #define SCROLL_CAPTURE_THRESHOLD_MS 150
 #define VELOCITY_ACCUMULATION_FLOOR 0.33
 #define VELOCITY_ACCUMULATION_CEIL 1.0
@@ -225,6 +227,10 @@
   GtkWidget     *vscrollbar;
 
   GtkCssGadget  *gadget;
+
+  /* Clip native child windows independently of the fixed scrollbars. */
+  GdkWindow     *view_window;
+  GdkWindow     *bin_window;
   GtkCssNode    *overshoot_node[4];
   GtkCssNode    *undershoot_node[4];
 
@@ -953,47 +959,50 @@
   gtk_gesture_set_sequence_state (gesture, sequence, state);
 }
 
+static gint
+scrolled_window_get_visual_overshoot (gint overshoot)
+{
+  gint distance;
+  gint sign;
+
+  if (overshoot == 0)
+    return 0;
+
+  sign = overshoot > 0 ? 1 : -1;
+  distance = ABS (overshoot);
+
+  return sign *
+         (OVERSHOOT_VISUAL_DISTANCE * distance) /
+         (distance + OVERSHOOT_VISUAL_RESISTANCE);
+}
+
+static void
+gtk_scrolled_window_update_visual_overshoot (GtkScrolledWindow *scrolled_window)
+{
+  GtkScrolledWindowPrivate *priv = scrolled_window->priv;
+  gint overshoot_x, overshoot_y;
+
+  /* Adjustment notifications also run while constructing/destroying bars. */
+  if (!priv->hscrollbar || !priv->vscrollbar)
+    return;
+
+  _gtk_scrolled_window_get_overshoot (scrolled_window, &overshoot_x, &overshoot_y);
+
+  if (priv->bin_window)
+    gdk_window_move (priv->bin_window,
+                     -scrolled_window_get_visual_overshoot (overshoot_x),
+                     -scrolled_window_get_visual_overshoot (overshoot_y));
+
+  /* Redraw the exposed gap as well as the content, including the final frame
+   * when the overshoot returns to zero.
+   */
+  gtk_widget_queue_draw (GTK_WIDGET (scrolled_window));
+}
+
 static void
 gtk_scrolled_window_invalidate_overshoot (GtkScrolledWindow *scrolled_window)
 {
-  GtkAllocation child_allocation;
-  gint overshoot_x, overshoot_y;
